# Leave empty in development: Vite proxies /api to the backend (see vite.config.js).
# In production, set it to the backend origin, for example https://api.example.com
VITE_API_URL=

# Development only: shows a "dev sign-in" button that uses `dev:<role>` tokens.
# Requires AUTH_DEV_BYPASS=true on the backend. Ignored by production builds.
VITE_AUTH_DEV_BYPASS=false
