# Copy to .env and fill in your values. Never commit .env.

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
# Comma-separated origins, or * to allow all.
CORS_ORIGINS=*
# Enable only behind Cloudflare; otherwise the CF-Connecting-IP header can be spoofed.
TRUST_CF_CONNECTING_IP=false

# ---- Database ----
# SQLite for local dev. For Supabase use the direct connection (port 5432, not the
# transaction pooler) because the LangGraph checkpointer needs it.
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# ---- Supabase Auth ----
SUPABASE_URL=
# Public anon key: used by /api/auth/* to call Supabase Auth.
SUPABASE_ANON_KEY=
# Public signing keys, used to verify access tokens without a network call.
SUPABASE_JWKS_JSON=
# Only for projects still issuing legacy HS256 tokens.
SUPABASE_JWT_SECRET=
# Development only: treat a `dev:<role>` bearer token as that role. Refused in production.
AUTH_DEV_BYPASS=false

# ---- LLM tiers ----
# Default chains per role:
#   planner        STRONG -> AVERAGE -> WEAK
#   writer         AVERAGE -> WEAK -> STRONG
#   brief_analyst  WEAK -> AVERAGE -> STRONG
STRONG_PROVIDER=openai_direct
STRONG_MODEL=gpt-4o
AVERAGE_PROVIDER=gemini
AVERAGE_MODEL=gemini-3.6-flash
WEAK_PROVIDER=groq
WEAK_MODEL=openai/gpt-oss-120b

# `openai_direct` reads OPENAI_DIRECT_API_KEY, not OPENAI_API_KEY.
OPENAI_DIRECT_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# `openai` provider: any OpenAI-compatible endpoint, with key rotation.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# OPENAI_API_KEYS=key1,key2,key3
LLM_MODEL=gpt-4o-mini

# `local` provider: self-hosted OpenAI-compatible endpoint.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=

# Quality judge: advisory only, must not run the writer's model.
JUDGE_PROVIDER=openai_direct
JUDGE_MODEL=gpt-4o

# Writer calls running at once inside a batch.
WRITER_CONCURRENCY=2

# ---- Embeddings (query encoding only) ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMBED_MODEL=@cf/baai/bge-m3
EMBED_DIM=1024
EMBED_TIMEOUT_SECONDS=20
EMBED_MAX_RETRIES=2

# ---- Qdrant ----
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=doc_chunks
QDRANT_TIMEOUT_SECONDS=30

# ---- Ground truth ----
# Name of the person who checked product_variants against the source pages.
# Empty, or a value starting with MACHINE, keeps citations labelled as unverified.
GROUND_TRUTH_VERIFIED_BY=
